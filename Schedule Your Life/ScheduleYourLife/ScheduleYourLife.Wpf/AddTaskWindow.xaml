<Window x:Class="ScheduleYourLife.Wpf.AddTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm Task Mới" Height="260" Width="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Tên công việc (Bắt buộc):" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtTitle" Padding="6" FontSize="13" Margin="0,0,0,15"/>

        <TextBlock Text="Chọn phân loại Ma trận Eisenhower:" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <ComboBox x:Name="CboQuadrant" Padding="6" FontSize="13" Margin="0,0,0,20"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" Width="80" Padding="6" Margin="0,0,10,0" IsCancel="True"/>
            <Button Content="Lưu Task" Width="90" Padding="6" Background="#2ECC71" Foreground="White" FontWeight="Bold" Click="BtnSave_Click"/>
        </StackPanel>
    </StackPanel>
</Window>