<Window x:Class="ScheduleYourLife.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScheduleYourLife - Auto Scheduler &amp; AI Assistant" 
        Height="760" Width="1200" WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="220"/>
        </Grid.RowDefinitions>

        <!-- 1. TOP BAR -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" Direction="270"/>
            </Border.Effect>
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="📅 SCHEDULE YOUR LIFE" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button x:Name="BtnAddTask" Content="➕ Thêm Task Mới" Background="#2ECC71" Foreground="White" 
                            FontWeight="SemiBold" Padding="12,6" Margin="0,0,10,0" Click="BtnAddTask_Click"/>
                    <Button x:Name="BtnHelp" Content="❓ Help &amp; Mô tả" Background="#3498DB" Foreground="White" 
                            FontWeight="SemiBold" Padding="12,6" Click="BtnHelp_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. KHU VỰC TRUNG TÂM (LỊCH PHIÊN 45P/15P & AI CHATBOX) -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Lịch xếp Task theo các phiên 45p làm + 15p nghỉ -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Margin="0,0,8,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="📆 LỊCH TRÌNH PHIÊN LÀM VIỆC (45p Làm / 15p Nghỉ)" FontWeight="Bold" FontSize="14" Foreground="#34495E"/>
                        <DatePicker x:Name="DpSelectedDate" Width="140" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <!-- Lưới 4 Ca làm việc chính -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ca Sáng -->
                        <Border Grid.Column="0" Background="#EBF5FB" CornerRadius="6" Margin="3" Padding="8">
                            <DockPanel>
                                <TextBlock Text="🌅 Ca Sáng (6h-12h)" DockPanel.Dock="Top" FontWeight="Bold" Foreground="#2980B9" Margin="0,0,0,5"/>
                                <ListBox x:Name="LstMorningShift" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}" ToolTip="Phiên 45 phút" Margin="0,2"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Ca Trưa -->
                        <Border Grid.Column="1" Background="#FEF9E7" CornerRadius="6" Margin="3" Padding="8">
                            <DockPanel>
                                <TextBlock Text="☀️ Ca Trưa (12h-13h)" DockPanel.Dock="Top" FontWeight="Bold" Foreground="#D68910" Margin="0,0,0,5"/>
                                <ListBox x:Name="LstNoonShift" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}" Margin="0,2"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Ca Chiều -->
                        <Border Grid.Column="2" Background="#E8F8F5" CornerRadius="6" Margin="3" Padding="8">
                            <DockPanel>
                                <TextBlock Text="🌇 Ca Chiều (13h-18h)" DockPanel.Dock="Top" FontWeight="Bold" Foreground="#117864" Margin="0,0,0,5"/>
                                <ListBox x:Name="LstAfternoonShift" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}" Margin="0,2"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Ca Tối -->
                        <Border Grid.Column="3" Background="#F4ECF7" CornerRadius="6" Margin="3" Padding="8">
                            <DockPanel>
                                <TextBlock Text="🌙 Ca Tối (18h-23h)" DockPanel.Dock="Top" FontWeight="Bold" Foreground="#6C3483" Margin="0,0,0,5"/>
                                <ListBox x:Name="LstEveningShift" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}" Margin="0,2"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- AI Chatbox -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Margin="8,0,0,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="🤖 AI ASSISTANT TƯ VẤN" FontWeight="Bold" FontSize="14" Foreground="#8E44AD" Margin="0,0,0,8"/>
                    <ListBox x:Name="LstAiChat" Grid.Row="1" Background="#F4F6F6" BorderThickness="0" Margin="0,0,0,8"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtAiInput" Grid.Column="0" Padding="6"/>
                        <Button x:Name="BtnSendAi" Grid.Column="1" Content="Gửi" Padding="10,6" Margin="5,0,0,0" 
                                Background="#8E44AD" Foreground="White" Click="BtnSendAi_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. BÊN DƯỚI: TASK LIST + NÚT XÓA COMPLETED TASKS -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12">
            <DockPanel>
                <!-- Header kèm Nút Xóa Task đã Hoàn Thành -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="📋 DANH SÁCH CÔNG VIỆC CẦN HOÀN THÀNH" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" VerticalAlignment="Center"/>
                    <Button x:Name="BtnClearCompleted" Content="🗑️ Loại bỏ Task đã xong" HorizontalAlignment="Right"
                            Background="#E74C3C" Foreground="White" FontWeight="SemiBold" Padding="10,4" Click="BtnClearCompleted_Click"/>
                </Grid>

                <!-- Danh sách Task -->
                <ListBox x:Name="LstTasks" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <CheckBox IsChecked="{Binding IsCompleted}" Content="{Binding Title}" FontSize="13" VerticalAlignment="Center" Click="CheckBox_Click"/>
                                <TextBlock Text="{Binding AssignedQuadrant, StringFormat=' ({0})'}" Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>